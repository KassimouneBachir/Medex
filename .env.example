# Copier en .env.local puis adapter.
# 127.0.0.1 plutôt que localhost : Node résout localhost en IPv6 (::1), alors que mongod écoute en IPv4 par défaut.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=DossierMedical

# Chemin de mongosh.exe, utilisé par « npm run migration » et « npm run mongosh ».
# Inutile si la commande mongosh est déjà dans le PATH.
MONGOSH_PATH=C:\chemin\vers\mongosh\bin\mongosh.exe
